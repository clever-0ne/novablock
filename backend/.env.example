# ============ NovaBlock.io backend configuration ============
# Local: copy this file to backend/.env and fill in your real values.
# Vercel: add the same keys under Project → Settings → Environment Variables.
# NEVER commit the real `.env` — it holds secrets.

# Environment: development | production
NODE_ENV=development
PORT=3000

# Allowed browser origins (comma-separated). Same-origin requests always pass.
APP_ORIGIN=http://localhost:3000

# =1 when running behind a reverse proxy so rate limiters see the real client IP
TRUST_PROXY=0

# Force Secure cookies over plain HTTP (dev only; production is always Secure)
COOKIE_SECURE=0

# Session lifetime (days) — sessions are swept after this
SESSION_TTL_DAYS=7

# bcrypt cost (12 = OWASP 2026 floor)
BCRYPT_ROUNDS=12

# ---- database (REQUIRED) ----
# Postgres connection string (Neon / Supabase). On Vercel use the pooled URL.
DATABASE_URL=postgres://user:password@host:6543/postgres

# ---- secrets (REQUIRED in production) ----
# Admin panel password
ADMIN_PASS=CHANGE_ME
# HMAC secret that signs KYC document URLs
KYC_URL_SECRET=CHANGE_ME_TOO

# ---- email / SMTP ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
MAIL_FROM=NovaBlock.io <no-reply@yourdomain.com>
SITE_URL=http://localhost:3000/
